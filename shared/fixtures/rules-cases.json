{
  "$comment": "Test vectors for the shared contract (rules.json version 2). rulesCases inputs are already aggregated - they are what DayInputs looks like after aggregation - and expectations are derived by hand from rules.json. aggregationCases exercise the aggregation itself from raw Open-Meteo samples. Consumed by reterminal-e1001/tools/gen.py -> test/test_rules/fixtures.h.",

  "$hoursFormat": "'hours' is a range spec over local hours: \"6-19:1\" means hours 6 through 19 all have WMO code 1; \"6-10:3,11-19:1\" means cloudy 6-10 then clear 11-19. These are the daylight-window rows, already filtered.",

  "defaults": {
    "nowMinutes": 720,
    "sunriseMinutes": 390,
    "sunsetMinutes": 1185,
    "$comment": "Default sun 06:30-19:45, so the daylight window is hours 6..19 - fourteen rows.",
    "day": {
      "temp": 78, "tempMin": 60, "precipProb": 10, "wind": 10,
      "aqi": 40, "aqiMin": 20, "uv": 7, "humidityMin": 40, "humidityMax": 62,
      "weatherCode": 1, "sunriseMin": 390, "sunsetMin": 1185, "hours": "6-19:1"
    }
  },

  "rulesCases": [
    { "name": "beach_day_baseline",
      "expect": { "state": "beach_day", "isNight": false, "cond": { "temp": true, "precip": true, "wind": true, "aqi": true, "forecast": true, "time": true },
                  "sunHours": 14, "sunText": "All day", "clearingTime": "6 AM", "clearingLater": false } },

    { "name": "night_before_sunrise", "nowMinutes": 300,
      "expect": { "state": "night_time", "isNight": true, "cond": { "time": false, "temp": true, "precip": true } } },
    { "name": "night_inside_sunset_buffer", "nowMinutes": 1150,
      "expect": { "state": "night_time", "isNight": true } },
    { "name": "day_at_sunset_buffer_edge", "nowMinutes": 1125,
      "expect": { "state": "beach_day", "isNight": false } },
    { "name": "day_at_sunrise_edge", "nowMinutes": 390, "expect": { "state": "beach_day" } },
    { "name": "night_one_minute_before_sunrise", "nowMinutes": 389, "expect": { "state": "night_time" } },
    { "name": "sun_unknown_is_always_day", "nowMinutes": 120, "sunriseMinutes": 0, "sunsetMinutes": 0,
      "expect": { "state": "beach_day", "cond": { "time": true } } },
    { "name": "sunrise_alone_unknown_is_day", "nowMinutes": 120, "sunriseMinutes": 0,
      "expect": { "state": "beach_day", "cond": { "time": true } } },

    { "name": "indoor_day", "today": { "aqi": 120 },
      "expect": { "state": "indoor_day", "cond": { "aqi": false } } },
    { "name": "aqi_99_passes", "today": { "aqi": 99 }, "expect": { "state": "beach_day" } },
    { "name": "aqi_100_fails", "today": { "aqi": 100 }, "expect": { "state": "indoor_day" } },

    { "name": "rain_day", "today": { "precipProb": 45 },
      "expect": { "state": "rain_day", "cond": { "precip": false } } },
    { "name": "precip_19_passes", "today": { "precipProb": 19 }, "expect": { "state": "beach_day" } },
    { "name": "precip_20_fails_but_not_rain_day", "today": { "precipProb": 20 },
      "expect": { "state": "just_a_day", "cond": { "precip": false } } },
    { "name": "precip_39_is_just_a_day", "today": { "precipProb": 39 }, "expect": { "state": "just_a_day" } },
    { "name": "precip_40_is_rain_day", "today": { "precipProb": 40 }, "expect": { "state": "rain_day" } },

    { "name": "wind_day", "today": { "wind": 20 },
      "expect": { "state": "wind_day", "cond": { "wind": false } } },
    { "name": "wind_15_passes", "today": { "wind": 15 }, "expect": { "state": "beach_day" } },
    { "name": "wind_16_fails", "today": { "wind": 16 }, "expect": { "state": "wind_day" } },

    { "name": "chilly_day", "today": { "temp": 60 },
      "expect": { "state": "chilly_day", "cond": { "temp": false } } },
    { "name": "chilly_at_64", "today": { "temp": 64 }, "expect": { "state": "chilly_day" } },
    { "name": "nice_at_65", "today": { "temp": 65 }, "expect": { "state": "nice_day" } },
    { "name": "nice_at_74", "today": { "temp": 74 },
      "expect": { "state": "nice_day", "cond": { "temp": false } } },
    { "name": "beach_at_75", "today": { "temp": 75 }, "expect": { "state": "beach_day" } },

    { "name": "grey_day_no_sun_at_all", "today": { "weatherCode": 3, "hours": "6-19:3" },
      "expect": { "state": "grey_day", "cond": { "forecast": false }, "sunHours": 0, "sunText": "Cloudy", "clearingTime": "" } },

    { "$comment": "minSunHours: the dawn-sun cases that motivated the rule.",
      "name": "one_dawn_sun_hour_fails_min", "today": { "weatherCode": 3, "hours": "6:1,7-19:3" },
      "expect": { "state": "grey_day", "cond": { "forecast": false }, "sunHours": 1, "sunText": "1 hr" } },
    { "name": "two_sun_hours_fails_min", "today": { "weatherCode": 3, "hours": "6-7:1,8-19:3" },
      "expect": { "state": "grey_day", "cond": { "forecast": false }, "sunHours": 2, "sunText": "2 hrs" } },
    { "name": "three_sun_hours_meets_min", "today": { "weatherCode": 3, "hours": "6-8:1,9-19:3" },
      "expect": { "state": "beach_day", "cond": { "forecast": true }, "sunHours": 3, "sunText": "3 hrs", "clearingLater": false } },
    { "name": "sunny_mode_but_no_sunny_hours_still_fails", "today": { "weatherCode": 2, "hours": "6-19:3" },
      "expect": { "state": "grey_day", "cond": { "forecast": false }, "sunHours": 0,
                  "$comment": "Synthetic: mode says sunny while no row is. minSunHours vetoes it." } },

    { "name": "clearing_at_11_is_beach", "today": { "weatherCode": 3, "hours": "6-10:3,11-19:1" },
      "expect": { "state": "beach_day", "cond": { "forecast": true }, "sunHours": 9, "sunText": "At 11 AM", "clearingTime": "11 AM", "clearingLater": true } },
    { "name": "clearing_at_2pm_is_beach", "today": { "weatherCode": 3, "hours": "6-13:3,14-19:1" },
      "expect": { "state": "beach_day", "sunHours": 6, "sunText": "At 2 PM" } },
    { "name": "clearing_at_3pm_is_grey", "today": { "weatherCode": 3, "hours": "6-14:3,15-19:1" },
      "expect": { "state": "grey_day", "cond": { "forecast": false }, "sunHours": 5, "sunText": "At 3 PM", "clearingLater": true } },
    { "name": "late_clearing_with_only_two_hours", "today": { "weatherCode": 3, "hours": "6-17:3,18-19:1" },
      "expect": { "state": "grey_day", "cond": { "forecast": false }, "sunHours": 2, "sunText": "At 6 PM" } },
    { "name": "nice_day_clearing", "today": { "temp": 70, "weatherCode": 3, "hours": "6-10:3,11-19:1" },
      "expect": { "state": "nice_day", "sunText": "At 11 AM" } },
    { "name": "one_cloudy_hour_still_all_day", "today": { "hours": "6-18:1,19:3" },
      "expect": { "state": "beach_day", "sunHours": 13, "sunText": "All day" } },
    { "name": "two_cloudy_hours_shows_count", "today": { "hours": "6-17:1,18-19:3" },
      "expect": { "state": "beach_day", "sunHours": 12, "sunText": "12 hrs" } },

    { "name": "chilly_beats_grey", "today": { "temp": 50, "weatherCode": 3, "hours": "6-19:3" },
      "expect": { "state": "chilly_day" } },
    { "name": "indoor_beats_rain", "today": { "aqi": 150, "precipProb": 60 }, "expect": { "state": "indoor_day" } },
    { "name": "rain_beats_wind", "today": { "precipProb": 50, "wind": 25 }, "expect": { "state": "rain_day" } },
    { "name": "wind_beats_chilly", "today": { "wind": 25, "temp": 50 }, "expect": { "state": "wind_day" } },
    { "name": "mild_dry_cloudless_is_just_a_day", "today": { "precipProb": 25 }, "expect": { "state": "just_a_day" } },

    { "name": "night_flags_come_from_tomorrow", "nowMinutes": 300, "tomorrow": { "precipProb": 50 },
      "expect": { "state": "night_time", "cond": { "precip": false }, "shown": "tomorrow" } },
    { "name": "night_ignores_today", "nowMinutes": 300, "today": { "precipProb": 90 },
      "expect": { "state": "night_time", "cond": { "precip": true }, "shown": "tomorrow" } },
    { "name": "night_uses_tomorrows_own_sun_scan", "nowMinutes": 300,
      "tomorrow": { "weatherCode": 3, "hours": "7:1,8-18:3", "sunriseMin": 450, "sunsetMin": 1110 },
      "expect": { "state": "night_time", "cond": { "forecast": false }, "sunHours": 1, "shown": "tomorrow" } },
    { "name": "day_shows_today", "expect": { "shown": "today" } }
  ],

  "parkingRulesDefault": [
    { "enabled": true, "side": "LEFT",  "weeks": [1, 3], "day": "Wednesday", "start": "08:00", "end": "10:00" },
    { "enabled": true, "side": "RIGHT", "weeks": [1, 3], "day": "Thursday",  "start": "08:00", "end": "10:00" }
  ],
  "parkingCases": [
    { "name": "wed_week1_morning_left_active",
      "input": { "nowMinutes": 540, "todayDow": 3, "todayDom": 3, "tomorrowDow": 4, "tomorrowDom": 4, "sunsetMinutes": 1185 },
      "expect": { "active": true, "text": "NO PARKING LEFT SIDE: 8-10AM" } },
    { "name": "wed_week1_exactly_at_end_still_active",
      "input": { "nowMinutes": 600, "todayDow": 3, "todayDom": 3, "tomorrowDow": 4, "tomorrowDom": 4, "sunsetMinutes": 1185 },
      "expect": { "active": true } },
    { "name": "wed_week1_after_end_inactive",
      "input": { "nowMinutes": 601, "todayDow": 3, "todayDom": 3, "tomorrowDow": 4, "tomorrowDom": 4, "sunsetMinutes": 1185 },
      "expect": { "active": false } },
    { "name": "wed_week1_evening_right_side_for_thursday",
      "input": { "nowMinutes": 1200, "todayDow": 3, "todayDom": 3, "tomorrowDow": 4, "tomorrowDom": 4, "sunsetMinutes": 1185 },
      "expect": { "active": true, "text": "NO PARKING RIGHT SIDE: 8-10AM" } },
    { "name": "tue_evening_before_wed_week1",
      "input": { "nowMinutes": 1200, "todayDow": 2, "todayDom": 2, "tomorrowDow": 3, "tomorrowDom": 3, "sunsetMinutes": 1185 },
      "expect": { "active": true, "text": "NO PARKING LEFT SIDE: 8-10AM" } },
    { "name": "tue_evening_before_wed_week2_inactive",
      "input": { "nowMinutes": 1200, "todayDow": 2, "todayDom": 9, "tomorrowDow": 3, "tomorrowDom": 10, "sunsetMinutes": 1185 },
      "expect": { "active": false } },
    { "name": "tue_evening_before_wed_week3",
      "input": { "nowMinutes": 1200, "todayDow": 2, "todayDom": 16, "tomorrowDow": 3, "tomorrowDom": 17, "sunsetMinutes": 1185 },
      "expect": { "active": true } },
    { "name": "tue_afternoon_before_sunset_inactive",
      "input": { "nowMinutes": 1184, "todayDow": 2, "todayDom": 2, "tomorrowDow": 3, "tomorrowDom": 3, "sunsetMinutes": 1185 },
      "expect": { "active": false } },
    { "name": "sunset_fallback_1929_inactive",
      "input": { "nowMinutes": 1169, "todayDow": 2, "todayDom": 2, "tomorrowDow": 3, "tomorrowDom": 3, "sunsetMinutes": 0 },
      "expect": { "active": false } },
    { "name": "sunset_fallback_1930_active",
      "input": { "nowMinutes": 1170, "todayDow": 2, "todayDom": 2, "tomorrowDow": 3, "tomorrowDom": 3, "sunsetMinutes": 0 },
      "expect": { "active": true } },
    { "name": "week5",
      "rules": [ { "enabled": true, "side": "LEFT", "weeks": [5], "day": "Wednesday", "start": "08:00", "end": "10:00" } ],
      "input": { "nowMinutes": 540, "todayDow": 3, "todayDom": 29, "tomorrowDow": 4, "tomorrowDom": 30, "sunsetMinutes": 1185 },
      "expect": { "active": true } },
    { "name": "disabled_rule_ignored",
      "rules": [ { "enabled": false, "side": "LEFT", "weeks": [1, 3], "day": "Wednesday", "start": "08:00", "end": "10:00" } ],
      "input": { "nowMinutes": 540, "todayDow": 3, "todayDom": 3, "tomorrowDow": 4, "tomorrowDom": 4, "sunsetMinutes": 1185 },
      "expect": { "active": false } },
    { "name": "pm_text_shares_meridiem",
      "rules": [ { "enabled": true, "side": "RIGHT", "weeks": [1], "day": "Monday", "start": "13:00", "end": "15:00" } ],
      "input": { "nowMinutes": 540, "todayDow": 1, "todayDom": 1, "tomorrowDow": 2, "tomorrowDom": 2, "sunsetMinutes": 1185 },
      "expect": { "active": true, "text": "NO PARKING RIGHT SIDE: 1-3PM" } },
    { "name": "mixed_meridiem_text_keeps_both",
      "rules": [ { "enabled": true, "side": "LEFT", "weeks": [1], "day": "Monday", "start": "11:30", "end": "13:00" } ],
      "input": { "nowMinutes": 540, "todayDow": 1, "todayDom": 1, "tomorrowDow": 2, "tomorrowDom": 2, "sunsetMinutes": 1185 },
      "expect": { "active": true, "text": "NO PARKING LEFT SIDE: 11:30AM-1PM" } }
  ],

  "$aggregationFormat": "'wx' rows are [day, hour, code, precipProb, humidity] with trailing fields optional (-1 = missing). 'aqi' rows are [day, hour, us_aqi]. 'daily' is [today, tomorrow] with sunriseMin/sunsetMin in local minutes.",
  "aggregationCases": [
    { "name": "window_is_each_days_own_sunrise_to_sunset",
      "wx": [[0,7,61],[0,8,1],[0,17,1],[0,18,61],[1,7,61],[1,8,61],[1,9,1],[1,16,1],[1,17,61]],
      "daily": [ { "code": 3, "sunriseMin": 480, "sunsetMin": 1020 }, { "code": 3, "sunriseMin": 540, "sunsetMin": 960 } ],
      "expect": { "today":    { "hourCount": 2, "firstHour": 8, "firstHourCode": 1, "lastHour": 17, "lastHourCode": 1, "weatherCode": 1 },
                  "tomorrow": { "hourCount": 2, "firstHour": 9, "firstHourCode": 1, "lastHour": 16, "lastHourCode": 1, "weatherCode": 1 },
                  "$comment": "Today's window is 8..17 so the 7 and 18 rain rows drop out; tomorrow's is 9..16 so its 7, 8 and 17 rows drop out. Tomorrow uses TOMORROW's sun, not today's." } },

    { "name": "mode_tie_goes_to_lower_code",
      "wx": [[0,9,3],[0,10,3],[0,11,3],[0,12,1],[0,13,1],[0,14,1]],
      "daily": [ { "code": 3, "sunriseMin": 540, "sunsetMin": 900 }, {} ],
      "expect": { "today": { "weatherCode": 1, "conditionText": "Mainly clear" } } },
    { "name": "mode_majority",
      "wx": [[0,9,3],[0,10,3],[0,11,3],[0,12,3],[0,13,1],[0,14,1]],
      "daily": [ { "code": 1, "sunriseMin": 540, "sunsetMin": 900 }, {} ],
      "expect": { "today": { "weatherCode": 3, "conditionText": "Overcast" } } },
    { "name": "no_rows_in_window_falls_back_to_daily_code",
      "wx": [[0,3,1],[0,4,1]],
      "daily": [ { "code": 61, "sunriseMin": 480, "sunsetMin": 1020 }, {} ],
      "expect": { "today": { "weatherCode": 61, "conditionText": "Slight rain", "hourCount": 0 } } },

    { "name": "aqi_uses_each_days_own_window",
      "aqi": [[0,5,500],[0,6,10],[0,19,90],[0,20,400],[1,6,300],[1,7,20],[1,18,60],[1,19,300]],
      "daily": [ { "sunriseMin": 401, "sunsetMin": 1192 }, { "sunriseMin": 450, "sunsetMin": 1110 } ],
      "expect": { "sunriseMinutes": 401, "sunsetMinutes": 1192,
                  "today":    { "aqi": 90, "aqiMin": 10 },
                  "tomorrow": { "aqi": 60, "aqiMin": 20 } } },
    { "name": "aqi_window_fallback_6_to_20",
      "aqi": [[0,5,500],[0,6,10],[0,20,150],[0,21,999]],
      "daily": [ {}, {} ],
      "expect": { "sunriseMinutes": 0, "today": { "aqi": 150, "aqiMin": 10 } } },

    { "name": "precip_is_window_max_for_both_days",
      "wx": [[0,7,1,90],[0,8,1,15],[0,17,1,30],[0,18,1,95],[1,8,1,80],[1,9,1,25],[1,16,1,5],[1,17,1,99]],
      "daily": [ { "precipProbMax": 95, "sunriseMin": 480, "sunsetMin": 1020 },
                 { "precipProbMax": 99, "sunriseMin": 540, "sunsetMin": 960 } ],
      "expect": { "today": { "precipProb": 30 }, "tomorrow": { "precipProb": 25 },
                  "$comment": "Symmetric: both are the hourly max inside their own window, not the API daily max." } },
    { "name": "precip_falls_back_to_daily_max_with_no_rows",
      "wx": [[0,3,1,88]],
      "daily": [ { "precipProbMax": 44, "sunriseMin": 480, "sunsetMin": 1020 }, {} ],
      "expect": { "today": { "precipProb": 44 } } },

    { "name": "humidity_is_window_only_not_all_day",
      "wx": [[0,3,1,0,95],[0,8,1,0,70],[0,12,1,0,30],[0,17,1,0,55],[0,22,1,0,98]],
      "daily": [ { "sunriseMin": 480, "sunsetMin": 1020 }, {} ],
      "expect": { "today": { "humidityMin": 30, "humidityMax": 70 },
                  "$comment": "The 3 AM and 10 PM peaks of 95/98 are outside the window and excluded." } },

    { "name": "rounding_happens_once",
      "daily": [ { "tempMax": 74.45, "tempMin": 59.949, "windMax": 15.04, "uvMax": 6.5 },
                 { "tempMax": 74.5, "windMax": 15.5 } ],
      "expect": { "today":    { "temp": 74, "tempMin": 60, "wind": 15, "uv": 7 },
                  "tomorrow": { "temp": 75, "wind": 16 },
                  "$comment": "74.45 rounds to 74, NOT 75 - a single half-up round, no intermediate one-decimal stage. 74.5 and 15.5 round half-up to 75 and 16." } }
  ]
}
